  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialPanel: {fileID: 534522849}
  tutorialText: {fileID: 1299110658}
  nextButton: {fileID: 599613389}
  skipButton: {fileID: 636935742}
  tutorialSteps:
  - " \u0421\u0432\u0430\u0439\u043F \u0432\u043B\u0435\u0432\u043E/\u0432\u043F\u0440\u0430\u0432\u043E
    \u2014 \u0434\u0432\u0438\u0433\u0430\u0439 \u0444\u0438\u0433\u0443\u0440\u0443"
  - " \u0421\u0432\u0430\u0439\u043F \u0432\u043D\u0438\u0437 \u2014 \u0431\u044B\u0441\u0442\u0440\u043E\u0435
    \u043F\u0430\u0434\u0435\u043D\u0438\u0435"
  - "\u0422\u0430\u043F \u043F\u043E \u044D\u043A\u0440\u0430\u043D\u0443 \u2014
    \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439 \u0444\u0438\u0433\u0443\u0440\u0443"
  - " \u0421\u043E\u0435\u0434\u0438\u043D\u044F\u0439 5+ \u0431\u043B\u043E\u043A\u0430
    \u043E\u0434\u043D\u043E\u0433\u043E \u0446\u0432\u0435\u0442\u0430 \u043F\u043E
    \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u0438, \u0447\u0442\u043E\u0431\u044B
    \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u043B\u0438\u043D\u0438\u044E!"
  - "\u0424\u0438\u0433\u0443\u0440\u0430 \u0440\u0430\u0441\u0441\u043F\u0430\u0434\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 4 \u0431\u043B\u043E\u043A\u0430,\u0445\u0430\u043E\u0442\u0438\u0447\u043D\u043E
    \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u044F \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0435
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435 \u044F\u0447\u0435\u0439\u043A\u0438"
